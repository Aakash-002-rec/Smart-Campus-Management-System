# Smart Campus Management System - Root .htaccess Configuration

# Prioritize index.php for Apache environments (XAMPP & PHP web servers)
<IfModule mod_dir.c>
    DirectoryIndex index.php index.html
</IfModule>

# Disable Directory Browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# UTF-8 Default Charset
AddDefaultCharset UTF-8

# Protect Sensitive Files, Credentials, and Configuration Files
<FilesMatch "^\.env|Dockerfile|docker-compose\.yml|db_credentials|\.(sql|bak|backup|log|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
